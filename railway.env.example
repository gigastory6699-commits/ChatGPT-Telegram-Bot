# ============================================================
#   Railway Environment Variables - ChatGPT Telegram Bot
#   Copy these into Railway → Variables tab
# ============================================================

# ─── 🤖 TELEGRAM ─────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── 🔑 API الرئيسي (OpenAI أو أي مزود) ─────────────────────
API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1/chat/completions
MODEL=gpt-4o

# ─── 🔄 GROQ Fallback (تلقائي عند انتهاء المفتاح الرئيسي) ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=gpt-oss-120b

# ─── ⚙️ إعدادات البوت ────────────────────────────────────────
CHAT_MODE=global
LANGUAGE=Arabic
PASS_HISTORY=9999
temperature=0.5
RESET_TIME=3600

# ─── 🌐 Webhook (اتركه فارغاً إذا لم تستخدم Webhook) ────────
# WEB_HOOK=https://your-app.railway.app

# ─── 👥 القوائم (اختياري) ────────────────────────────────────
# ADMIN_LIST=123456789,987654321
# whitelist=123456789,987654321
# BLACK_LIST=

# ─── 🔌 Plugins & Features ───────────────────────────────────
GET_MODELS=True
LONG_TEXT=True
LONG_TEXT_SPLIT=True
FILE_UPLOAD_MESS=True
FOLLOW_UP=False
TITLE=False
REPLY=False
VOICE_REPLY=False
IMAGEQA=False

# ─── 🏷️ اختياري ───────────────────────────────────────────────
# NICK=BotName
# SYSTEMPROMPT=You are a helpful assistant.
